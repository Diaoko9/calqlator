  <property name="styleSheet">
   <string notr="true">/* --- Main Window Background --- */
QWidget#centralwidget {
    background-color: #1c1c1e; /* Deep Apple-style dark mode */
}

/* --- Display Screen --- */
QLineEdit#display {
    background-color: #1c1c1e;
    color: #ffffff;
    border: none;
    font-size: 64px;
    font-family: &quot;Segoe UI&quot;, &quot;San Francisco&quot;, &quot;Helvetica Neue&quot;, sans-serif;
    qproperty-alignment: 'AlignRight|AlignTrailing|AlignVCenter';
    padding-right: 15px;
    margin-bottom: 20px;
}

/* --- Standard Digits --- */
QPushButton {
    background-color: #333336;
    color: #ffffff;
    border: none;
    border-radius: 12px; /* Smooth rounded corners */
    font-size: 28px;
    font-weight: 500;
    min-width: 70px;
    min-height: 70px;
}

QPushButton:hover {
    background-color: #444447; /* Subtle highlight on hover */
}

QPushButton:pressed {
    background-color: #555559; /* Bright flash on click */
}

/* --- Operator Buttons --- */
QPushButton#btnAdd, QPushButton#btnSubtract, QPushButton#btnMultiply, QPushButton#btnDivide, QPushButton#btnEqual {
    background-color: #ff9f0a; /* Modern neon orange accent */
    color: #ffffff;
    font-size: 32px;
}

QPushButton#btnAdd:hover, QPushButton#btnSubtract:hover, QPushButton#btnMultiply:hover, QPushButton#btnDivide:hover, QPushButton#btnEqual:hover {
    background-color: #ffb03a;
}

QPushButton#btnAdd:pressed, QPushButton#btnSubtract:pressed, QPushButton#btnMultiply:pressed, QPushButton#btnDivide:pressed, QPushButton#btnEqual:pressed {
    background-color: #e08c09;
}

QPushButton#btnClear {
    background-color: #a5a5a5; /* Light grey */
    color: #000000; /* Dark text */
}

QPushButton#btnClear:hover {
    background-color: #d4d4d2;
}

QPushButton#btnClear:pressed {
    background-color: #8e8e8e;
}</string>
